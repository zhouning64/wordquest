# WordQuest configuration.
# Copy this file to .env (git-ignored) and fill in your own values.
# Never put real keys or passcodes in this example file.
# Secret values are left empty here; the comment above each one shows its shape.

# --- AI text generation (Cerebras, OpenAI-compatible API) ---
# Empty = AI disabled: the app still runs with the starter set and content generated earlier.
# Example: CEREBRAS_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CEREBRAS_API_KEY=
# Any Cerebras model that supports strict json_schema output.
CEREBRAS_MODEL=qwen-3.8-27b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# Sent as max_completion_tokens on every call (reasoning models spend tokens before output).
LLM_MAX_COMPLETION_TOKENS=40000
# Seconds before one LLM HTTP request times out.
LLM_TIMEOUT_S=180

# --- Pictures (chosen provider: z.ai) ---
# "none" (emoji fallback only) or "openai_compatible": POST <IMAGE_BASE_URL>/images/generations with
# {"model", "prompt", "size"}, plus "quality" when IMAGE_QUALITY is set (no "n", no "response_format").
# The picture is read from data[0].b64_json, or downloaded at once from data[0].url (z.ai answers with a
# link that expires after 30 days). Pictures larger than 20 MB are refused.
# openai_compatible needs IMAGE_BASE_URL, IMAGE_API_KEY and IMAGE_MODEL; if one is missing the app still starts,
# with pictures off, and Parent -> Status & backup says what to fix.
# Example (z.ai): IMAGE_PROVIDER=openai_compatible
IMAGE_PROVIDER=none
# Create the key at https://z.ai/manage-apikey/apikey-list and put it only in .env (never in git).
# Example: IMAGE_API_KEY=<your z.ai API key>
IMAGE_API_KEY=
# z.ai image model: glm-image or cogview-4-250304. Example: IMAGE_MODEL=glm-image
IMAGE_MODEL=
# Base URL for the openai_compatible provider (required; there is no default, so the key never goes elsewhere).
# Example (z.ai): IMAGE_BASE_URL=https://api.z.ai/api/paas/v4
IMAGE_BASE_URL=
# Sent as "size" (WIDTHxHEIGHT). glm-image: 1024-2048 px per side, multiples of 32, at most 2^22 pixels
# (z.ai default 1280x1280); cogview-4-250304: 512-2048 px per side, multiples of 16, at most 2^21 pixels
# (z.ai default 1024x1024). 1024x1024 is valid for both.
IMAGE_SIZE=1024x1024
# Sent as "quality" only when set: standard | hd. Empty = the model's default (glm-image: hd, about 20 s;
# cogview-4-250304: standard, about 5-10 s). Example: IMAGE_QUALITY=standard
IMAGE_QUALITY=

# --- Access control ---
# Shared code for the whole site. Empty = no gate (fine on 127.0.0.1).
# Set it before running with --host 0.0.0.0. Example: SITE_ACCESS_CODE=pick-a-family-code
SITE_ACCESS_CODE=
# Passcode for the Parent area. Empty = Parent area disabled. Example: PARENT_PASSCODE=pick-a-parent-passcode
PARENT_PASSCODE=
# Cookie signing key. Empty = generated once and saved to DATA_DIR/secret_key.
# Example: SECRET_KEY=<64 random hex characters, e.g. from: python -c "import secrets; print(secrets.token_hex(32))">
SECRET_KEY=

# --- Storage ---
# Folder for wordquest.db, images/ and logs/.
DATA_DIR=./data
# "local" in Phase 1 (Phase 2 adds "gcp").
STORAGE=local

# --- Background generation ---
# Parallel generation jobs.
GEN_CONCURRENCY=3
# Cap on outbound LLM + image HTTP requests per UTC day; jobs are deferred (not failed) when hit.
AI_DAILY_CALL_LIMIT=2000
# Thinking level for Learn cards and questions: low, medium or high (empty = the model default).
LLM_REASONING_EFFORT=medium
